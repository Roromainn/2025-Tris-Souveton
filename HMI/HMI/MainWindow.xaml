<Window x:Class="HMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnGenerate" 
                    Content="Générer un tableau aléatoire" 
                    Padding="10"
                    Margin="10"
                    Height="40"
                    Click="GenerateRandomValues"/>
            <Button Content="Trier" Height="40" Width="63" Margin="10" Padding="10"
                    Click="DoSort"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ListValues" Grid.Column="0" Margin="0,0,10,0"/>

            <Canvas x:Name="MainCanvas" Grid.Column="1" Background="#F0F0F0"/>
        </Grid>
    </DockPanel>
</Window>